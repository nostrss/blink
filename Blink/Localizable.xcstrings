    "Turn it on or off from the •→ icon in the menu bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über das Symbol •→ in der Menüleiste ein- oder ausschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it on or off from the •→ icon in the menu bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo o desactívalo desde el icono •→ de la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez ou désactivez-le depuis l’icône •→ de la barre des menus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーの •→ アイコンからオン・オフできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴바의 •→ 아이콘에서 끄거나 켤 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative ou desative pelo ícone •→ na barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить или выключить можно через значок •→ в строке меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在菜单栏的 •→ 图标中开启或关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可在選單列的 •→ 圖像中開啟或關閉。"
          }
        }
      }
    },
