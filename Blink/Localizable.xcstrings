    "Display time is shared by the input source HUD and the pointer badge.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display time is shared by the input source HUD and the pointer badge."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시 시간은 입력소스 HUD와 포인터 배지가 함께 씁니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示時間は入力ソースHUDとポインタバッジで共通です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示时间由输入法 HUD 和指针徽章共用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示時間由輸入法 HUD 和指標徽章共用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anzeigedauer gilt für das Eingabequellen-HUD und das Zeigerabzeichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo de visualización lo comparten el HUD de fuente de entrada y la insignia del puntero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
