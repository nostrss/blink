    "When your input source changes, Blink briefly shows “before → after” in the center of the screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn sich die Eingabequelle ändert, zeigt Blink kurz „vorher → nachher“ in der Bildschirmmitte an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your input source changes, Blink briefly shows “before → after” in the center of the screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando cambia la fuente de entrada, Blink muestra brevemente «antes → después» en el centro de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand la source de saisie change, Blink affiche brièvement « avant → après » au centre de l’écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力ソースが切り替わると、画面中央に「切り替え前 → 切り替え後」を一瞬表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력소스가 바뀌면 화면 중앙에 '변경 전 → 변경 후'를 잠깐 보여 줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a fonte de entrada muda, o Blink mostra rapidamente “antes → depois” no centro da tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При смене источника ввода Blink ненадолго показывает «было → стало» в центре экрана."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入法切换时，Blink 会在屏幕中央短暂显示“切换前 → 切换后”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換輸入法時，Blink 會在螢幕中央短暫顯示「切換前 → 切換後」。"
          }
        }
      }
    },
