{
  "sourceLanguage": "en",
  "strings": {
    "0.5–5.0 seconds, in 0.5-second steps. The 0.3-second fade-out is added on top.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0,5–5,0 s in Schritten von 0,5 s. Das Ausblenden (0,3 s) kommt hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0.5–5.0 seconds, in 0.5-second steps. The 0.3-second fade-out is added on top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De 0,5 a 5,0 s, en intervalos de 0,5 s. El fundido de 0,3 s se suma aparte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "0,5 à 5,0 s, par pas de 0,5 s. Le fondu de 0,3 s s’y ajoute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0.5〜5.0秒、0.5秒単位。消えるまでの0.3秒は別に加算されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0.5–5.0초, 0.5초 단위. 사라지는 0.3초는 따로 더해집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De 0,5 a 5,0 s, em intervalos de 0,5 s. O esmaecimento de 0,3 s é somado à parte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "0,5–5,0 с, шаг 0,5 с. Плавное исчезновение (0,3 с) добавляется отдельно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0.5–5.0 秒，以 0.5 秒为单位。另外还有 0.3 秒的淡出时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "0.5–5.0 秒，以 0.5 秒為單位。另外還有 0.3 秒的淡出時間。"
          }
        }
      }
    },
