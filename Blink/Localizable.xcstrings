    "When Caps Lock changes, the HUD shows “⇪ On” or “⇪ Off”.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Caps Lock changes, the HUD shows “⇪ On” or “⇪ Off”."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lock을 바꾸면 '⇪ 켜짐'·'⇪ 꺼짐'을 보여 줍니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lockを切り替えると「⇪ オン」「⇪ オフ」を表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换大写锁定时显示“⇪ 开”或“⇪ 关”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換大寫鎖定時顯示「⇪ 開」或「⇪ 關」。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Wechsel der Feststelltaste zeigt das HUD „⇪ Ein“ oder „⇪ Aus“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cambiar Bloq Mayús, el HUD muestra «⇪ Activado» o «⇪ Desactivado»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au changement du verrouillage majuscule, le HUD affiche « ⇪ Activé » ou « ⇪ Désactivé »."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao mudar o Caps Lock, o HUD mostra “⇪ Ativado” ou “⇪ Desativado”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При смене Caps Lock HUD показывает «⇪ Вкл.» или «⇪ Выкл.»."
          }
        }
      }
    },
