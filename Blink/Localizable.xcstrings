    "Turn On Typing Statistics": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn On Typing Statistics"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이핑 통계 켜기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイピング統計をオン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开打字统计"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟打字統計"
          }
        },
        "de": {
          "stringUnit": {
