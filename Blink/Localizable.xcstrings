  "sourceLanguage": "en",
  "strings": {
    "0.5–5.0 seconds, in 0.5-second steps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0,5–5,0 s in Schritten von 0,5 s."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0.5–5.0 seconds, in 0.5-second steps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De 0,5 a 5,0 s, en intervalos de 0,5 s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "0,5 à 5,0 s, par pas de 0,5 s."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0.5〜5.0秒、0.5秒単位。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0.5–5.0초, 0.5초 단위."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De 0,5 a 5,0 s, em intervalos de 0,5 s."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "0,5–5,0 с, шаг 0,5 с."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0.5–5.0 秒，以 0.5 秒为单位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "0.5–5.0 秒，以 0.5 秒為單位。"
          }
        }
      }
    },
