    "Reduce Transparency is on in Accessibility, so the background is always shown opaque.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Transparenz reduzieren“ ist in den Bedienungshilfen aktiviert, daher wird der Hintergrund immer deckend angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce Transparency is on in Accessibility, so the background is always shown opaque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Reducir transparencia» está activado en Accesibilidad, así que el fondo siempre se muestra opaco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Réduire la transparence » est activé dans Accessibilité, le fond est donc toujours opaque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティの「透明度を下げる」がオンのため、背景は常に不透明で表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용의 ‘투명도 줄이기’가 켜져 있어 배경이 항상 불투명하게 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Reduzir transparência” está ativado em Acessibilidade, então o fundo sempre aparece opaco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Универсальном доступе включено «Уменьшение прозрачности», поэтому фон всегда непрозрачный."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于辅助功能中的“降低透明度”已打开，背景始终以不透明方式显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於輔助使用中的「減少透明度」已開啟，背景會一律以不透明方式顯示。"
          }
        }
      }
    },
