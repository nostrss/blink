    "See today’s input source switches at the top of the menu, and 7 or 30 days in “Statistics…”. Records stay on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oben im Menü siehst du die heutigen Eingabequellen-Wechsel, unter „Statistik …“ 7 oder 30 Tage. Die Daten bleiben auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See today’s input source switches at the top of the menu, and 7 or 30 days in “Statistics…”. Records stay on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta los cambios de fuente de entrada de hoy en la parte superior del menú, y 7 o 30 días en «Estadísticas…». Los datos se quedan en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez les changements de source de saisie du jour en haut du menu, et 7 ou 30 jours dans « Statistiques… ». Les données restent sur ce Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューの一番上で今日の入力ソースの切り替えを、「統計…」で7日・30日を確認できます。記録はこのMacの中だけに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 맨 위에서 오늘의 한/영 전환을, ‘통계…’에서 7⁠일·30⁠일을 봅니다. 기록은 이 Mac에만 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja as trocas de fonte de entrada de hoje no topo do menu, e 7 ou 30 dias em “Estatísticas…”. Os dados ficam neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодняшние переключения источника ввода — вверху меню, 7 или 30 дней — в «Статистика…». Данные остаются на этом Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单顶部查看今天的输入法切换，在“统计…”中查看 7 天或 30 天。记录只保存在这台 Mac 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選單頂端查看今天的輸入方式切換，在「統計…」中查看 7 天或 30 天。記錄只保留在這台 Mac 上。"
          }
        }
      }
    },
    "Settings are grouped into boxes, like System Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen sind wie in den Systemeinstellungen in Gruppen zusammengefasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings are grouped into boxes, like System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes se agrupan en recuadros, como en Ajustes del Sistema."
