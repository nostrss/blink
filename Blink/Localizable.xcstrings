    "Click a dot or drag the HUD to move it. While you move it, a preview appears at the same spot on your screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf einen Punkt oder ziehe das HUD. Beim Verschieben erscheint eine Vorschau an derselben Stelle auf dem Bildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click a dot or drag the HUD to move it. While you move it, a preview appears at the same spot on your screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un punto o arrastra el HUD. Mientras lo mueves, aparece una vista previa en el mismo lugar de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un point ou faites glisser le HUD. Pendant le déplacement, un aperçu s’affiche au même endroit de l’écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "点をクリックするかHUDをドラッグして移動します。移動中は画面上の同じ位置にプレビューが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점을 누르거나 HUD를 끌어서 옮깁니다. 옮기는 동안 실제 화면의 같은 자리에 HUD를 미리 보여 줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em um ponto ou arraste o HUD. Enquanto você o move, uma prévia aparece no mesmo lugar da tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите точку или перетащите HUD. Во время перемещения в том же месте экрана появляется превью."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按圆点或拖移 HUD 来移动它。移动时，屏幕上的相同位置会显示预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按圓點或拖移 HUD 來移動它。移動時，螢幕上的相同位置會顯示預覽。"
          }
        }
      }
    },
    "Click the Light or Dark preview to choose which colors to edit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf die helle oder dunkle Vorschau, um die zu bearbeitenden Farben zu wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the Light or Dark preview to choose which colors to edit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en la vista previa clara u oscura para elegir qué colores editar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur l’aperçu clair ou sombre pour choisir les couleurs à modifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライトまたはダークのプレビューをクリックして、編集する色を選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이트나 다크 미리보기를 눌러 편집할 색을 고릅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique na prévia clara ou escura para escolher quais cores editar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на светлый или тёмный образец, чтобы выбрать, какие цвета изменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按浅色或深色预览，选择要编辑的颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下淺色或深色預覽，選擇要編輯的顏色。"
          }
        }
      }
    },
