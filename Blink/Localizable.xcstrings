    "When off, no HUD appears and the menu bar icon is dimmed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aus, erscheint kein HUD und das Menüleistensymbol wird abgeblendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, no HUD appears and the menu bar icon is dimmed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está desactivado, no aparece el HUD y el icono de la barra de menús se atenúa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, le HUD n’apparaît plus et l’icône de la barre des menus est estompée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにするとHUDは表示されず、メニューバーのアイコンが薄くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 HUD가 뜨지 않고 메뉴바 아이콘이 흐려집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado, o HUD não aparece e o ícone da barra de menus fica esmaecido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда выключено, HUD не появляется, а значок в строке меню тускнеет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后不再显示 HUD，菜单栏图标会变暗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後不再顯示 HUD，選單列圖像會變暗。"
          }
        }
      }
    },
